{
  "rules": {
    "declaration-property-value-disallowed-list": {
      "/^(color|background|border|outline|fill|stroke|box-shadow|text-shadow)/": [
        "/#[0-9a-fA-F]{3,8}\\b/",
        "/\\brgba?\\(/",
        "/\\bhsla?\\(/",
        "/\\boklch\\(/"
      ],
      "/^(margin|padding|gap|font-size|border-radius|line-height|letter-spacing)/": [
        "/\\d+px/"
      ]
    }
  },
  "ignoreFiles": ["src/ui/tokens.css", "dist/**"]
}
